{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "2.0.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/lata-16.png",
    "32": "icons/lata-32.png",
    "48": "icons/lata-48.png",
    "128": "icons/lata-128.png"
  },
  "content_scripts": [
    {
      "matches": [
